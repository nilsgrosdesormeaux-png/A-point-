.import-ingredients-form {
  margin: 1.5rem 0;
}

.btn-import-open {
  padding: 0.75rem 1.5rem;
  background: linear-gradient(135deg, #8b6914 0%, #5a4206 100%);
  color: #f5f1e8;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(139, 105, 20, 0.3);
}

.btn-import-open:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(139, 105, 20, 0.4);
  background: linear-gradient(135deg, #9a7a1f 0%, #6b5209 100%);
}

.btn-import-open:active {
  transform: translateY(0);
}

.import-status-text {
  margin-top: 0.75rem;
  font-size: 0.9rem;
  color: #5a4206;
  font-weight: 500;
}

/* Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
  padding: 1rem;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-content {
  background: #f5f1e8;
  border-radius: 12px;
  width: 100%;
  max-width: 600px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  animation: slideIn 0.3s ease;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateY(-20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.5rem;
  border-bottom: 2px solid #e0d5c0;
  position: sticky;
  top: 0;
  background: #f5f1e8;
  z-index: 10;
}

.modal-header h2 {
  margin: 0;
  font-size: 1.4rem;
  color: #3a2c1a;
}

.btn-close {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  color: #8b6914;
  transition: color 0.2s;
  padding: 0;
  width: 2rem;
  height: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-close:hover {
  color: #3a2c1a;
}

.modal-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.import-instructions {
  background: #ede4d3;
  padding: 1.25rem;
  border-radius: 8px;
  border-left: 4px solid #8b6914;
}

.import-instructions h3 {
  margin: 0 0 0.75rem 0;
  color: #3a2c1a;
  font-size: 1rem;
}

.import-instructions p {
  margin: 0.5rem 0;
  font-size: 0.9rem;
  color: #5a4206;
  line-height: 1.5;
}

.import-instructions ul {
  margin: 0.75rem 0;
  padding-left: 1.5rem;
  color: #5a4206;
  font-size: 0.9rem;
}

.import-instructions li {
  margin: 0.35rem 0;
}

.example-text {
  background: white;
  padding: 0.75rem;
  border-radius: 6px;
  font-size: 0.85rem;
  color: #3a2c1a;
  font-family: 'Courier New', monospace;
  margin: 0.5rem 0 !important;
}

.example-text code {
  background: #e0d5c0;
  padding: 0.2rem 0.4rem;
  border-radius: 3px;
  font-size: 0.8rem;
}

/* File Upload Zone */
.file-upload-zone {
  position: relative;
  border: 2px dashed #8b6914;
  border-radius: 8px;
  padding: 2rem;
  text-align: center;
  background: white;
  transition: all 0.3s ease;
  cursor: pointer;
}

.file-upload-zone:hover {
  border-color: #5a4206;
  background: #ede4d3;
}

.file-input {
  display: none;
}

.file-label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  cursor: pointer;
  user-select: none;
}

.file-icon {
  font-size: 2.5rem;
  line-height: 1;
}

.file-text {
  color: #5a4206;
  font-weight: 500;
  line-height: 1.4;
}

.file-text small {
  font-size: 0.8rem;
  color: #8b6914;
  font-weight: 400;
}

.file-input:disabled ~ .file-label {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Status Messages */
.status-message {
  padding: 1rem;
  border-radius: 6px;
  font-size: 0.95rem;
  font-weight: 500;
  animation: fadeIn 0.3s ease;
}

.status-success {
  background: #d1f3d1;
  color: #0c5c0c;
  border-left: 4px solid #10b981;
}

.status-error {
  background: #fce8e8;
  color: #7c1414;
  border-left: 4px solid #dc2626;
  line-height: 1.5;
}

/* Modal Footer */
.modal-footer {
  padding: 1.5rem;
  border-top: 2px solid #e0d5c0;
  background: #ede4d3;
  text-align: center;
}

.btn-close-modal {
  padding: 0.75rem 1.5rem;
  background: #8b6914;
  color: #f5f1e8;
  border: none;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
}

.btn-close-modal:hover {
  background: #5a4206;
  transform: translateY(-1px);
}

/* Responsive */
@media (max-width: 640px) {
  .modal-content {
    max-width: 100%;
    border-radius: 12px 12px 0 0;
  }

  .import-instructions {
    padding: 1rem;
    font-size: 0.85rem;
  }

  .file-icon {
    font-size: 2rem;
  }
}
